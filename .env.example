# ===== ReqCraft AI - Environment Variables =====
# Copy this file to ".env" and fill in your keys

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=True

# Google Gemini (PRIMARY LLM) - get free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace (FALLBACK LLM) - get free token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-token-here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Ollama (LOCAL BACKUP) - optional, runs locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database
DATABASE_URL=sqlite:///reqcraft.db
